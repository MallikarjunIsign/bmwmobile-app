{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ImageStorage": {
    "Provider": "Local",
    "LocalPath": "uploads",
    "RequestPath": "/images",
    "PublicBaseUrl": "http://localhost:6001"
  },
  "ImageUpload": {
    "MaxFiles": 10,
    "MaxFileSizeMB": 5,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".webp" ]
  }
}
