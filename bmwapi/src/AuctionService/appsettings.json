{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ImageStorage": {
    "Provider": "Local",
    "LocalPath": "uploads",
    "RequestPath": "/images",
    "PublicBaseUrl": "http://localhost:6001",
    "Gcs": {
      "Bucket": "",
      "ObjectPrefix": "listings"
    }
  },
  "Geocoding": {
    "Provider": "BuiltIn",
    "CacheHours": 24,
    "Google": {
      "ApiKey": ""
    }
  },
  "Admin": {
    "Usernames": []
  },
  "Payments": {
    "CommissionPercent": 1.0,
    "PaymentDeadlineHours": 48,
    "SecondChanceOffers": 3,
    "ReservationMinutes": 15,
    "AutoCompleteDays": 7,
    "StrikeLimit": 2,
    "StrikeWindowMonths": 12,
    "AppTag": "shopcarparts",
    "PublicBaseUrl": "http://10.0.2.2:6001",
    "AppReturnUrl": "shopcarparts://payments"
  },
  "ImageUpload": {
    "MaxFiles": 20,
    "MaxFileSizeMB": 5,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".webp" ]
  }
}
