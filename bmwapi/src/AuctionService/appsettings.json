{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ImageStorage": {
    "Provider": "Local",
    "LocalPath": "uploads",
    "RequestPath": "/images",
    "PublicBaseUrl": "http://localhost:6001",
    "Gcs": {
      "Bucket": "",
      "ObjectPrefix": "listings"
    }
  },
  "Geocoding": {
    "Provider": "BuiltIn",
    "CacheHours": 24,
    "Google": {
      "ApiKey": ""
    }
  },
  "Admin": {
    "Usernames": []
  },
  "ImageUpload": {
    "MaxFiles": 20,
    "MaxFileSizeMB": 5,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".webp" ]
  }
}
