{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AntiSniping": {
    "Enabled": false,
    "WindowMinutes": 2,
    "ExtendMinutes": 2
  },
  "Auction": {
    "AllowAcceptBelowReserve": true,
    "ReserveGracePeriodHours": 24
  }
}
